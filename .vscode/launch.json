{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GDB: kvstore_server",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/kvstore_server",
      "args": [
        "--config",
        "${workspaceFolder}/config/config.json"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "GDB: kvstore_mock_client",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/kvstore_mock_client",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb"
    },
    {
      "name": "GDB: kvstore_uds_bridge_fixture",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/kvstore_uds_bridge_fixture",
      "args": [
        "${workspaceFolder}/build/debug-uds.sock",
        "debug-tenant",
        "debug-model"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb"
    },
