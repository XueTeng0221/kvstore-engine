+void nty_schedule_cancel_all(nty_schedule *sched) {
+	if (sched == NULL) return;
+	nty_coroutine *co = NULL;
+	while ((co = RB_MIN(_nty_coroutine_rbtree_wait, &sched->waiting)) != NULL) {
+		RB_REMOVE(_nty_coroutine_rbtree_wait, &sched->waiting, co);
