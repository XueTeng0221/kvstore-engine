+		event.data.fd = co->fd;
+		epoll_ctl(sched->poller_fd, EPOLL_CTL_DEL, co->fd, &event);
+		if (co->status & BIT(NTY_COROUTINE_STATUS_SLEEPING))
+			RB_REMOVE(_nty_coroutine_rbtree_sleep, &sched->sleeping, co);
+		co->status = BIT(NTY_COROUTINE_STATUS_READY);
+		TAILQ_INSERT_TAIL(&sched->ready, co, ready_next);
+	}
+	while ((co = RB_MIN(_nty_coroutine_rbtree_sleep, &sched->sleeping)) != NULL) {
+		RB_REMOVE(_nty_coroutine_rbtree_sleep, &sched->sleeping, co);
+		co->status = BIT(NTY_COROUTINE_STATUS_READY);
+		TAILQ_INSERT_TAIL(&sched->ready, co, ready_next);
+	}
+}
